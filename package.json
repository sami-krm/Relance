{
	"name": "relance",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite build && vite preview",
		"deploy": "vite build && wrangler deploy",
		"lint": "biome check src tests *.config.ts *.json *.jsonc",
		"typecheck": "wrangler types && tsc -p . && tsc -p src/client",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@tanstack/react-query": "^5.108.4",
		"better-auth": "^1.7.28",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.22",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.9",
		"@cloudflare/vite-plugin": "^1.70.2",
		"@cloudflare/vitest-plugin": "^1.9.2",
		"@tailwindcss/vite": "^4.3.5",
		"@types/react": "^19.3.3",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"drizzle-kit": "^0.31.11",
		"tailwindcss": "^4.3.5",
		"typescript": "~6.0.3",
		"vite": "^8.4.0",
		"vitest": "^5.1.2",
		"wrangler": "^4.168.0"
	}
}
