{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "relance",
	"main": "src/server/index.ts",
	"compatibility_date": "2026-11-23",
	// Better Auth a besoin d'AsyncLocalStorage, pas du reste de Node.
	"compatibility_flags": ["nodejs_als"],
	"vars": { "BETTER_AUTH_URL": "https://relance.skrim.dev" },
	"secrets": {
		"required": [
			"BETTER_AUTH_SECRET",
			"BREVO_API_KEY",
			"FRANCE_TRAVAIL_CLIENT_ID",
			"FRANCE_TRAVAIL_CLIENT_SECRET",
			"LBA_API_TOKEN"
		]
	},
	"ratelimits": [
		{
			"name": "LIMITE_LIENS",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		}
	],
	// Servi uniquement sur le domaine personnalisé, pas sur *.workers.dev.
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "relance.skrim.dev", "custom_domain": true }],
	// Le front est servi tel quel ; seul /api/* réveille le Worker.
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	// Workers AI : brouillons de lettres et d'e-mails (V2), 10 000 Neurons gratuits par jour.
	"ai": { "binding": "AI" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "relance",
			"database_id": "6a182d17-deb5-4625-b398-70a8e3f859a3",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "DOCUMENTS",
			"bucket_name": "relance-documents",
			"jurisdiction": "eu"
		}
	],
	// Rappels du matin. Les crons sont en UTC : 5 h et 6 h, le Worker n'envoie qu'à 7 h heure de Paris (été comme hiver).
	"triggers": { "crons": ["0 5 * * *", "0 6 * * *"] }
}
